# Copy this file to ".env" and fill in real values. Never commit the real ".env" file.

# Port the Express server listens on
PORT=4000

# Which frontend origin is allowed to call this API (CORS)
CORS_ORIGIN=http://localhost:3000

# Set to 1 behind a single trusted reverse proxy so req.ip and login limits use
# the real client address. Adjust to match the number of proxies in your host.
TRUST_PROXY=

# Postgres connection string from Neon, e.g.:
# postgres://user:password@ep-something.us-east-2.aws.neon.tech/walletapp?sslmode=require
DATABASE_URL=
# Keep certificate validation enabled for hosted databases. Set false only when
# developing against a trusted local database with a self-signed certificate.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Redis is optional locally. In production, set the TLS URL supplied by your
# managed Redis provider (usually redis:// or rediss://).
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=3000
CACHE_TTL_SECONDS=60

# Login attempts are limited per IP + normalized email address.
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX=10

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long an issued JWT stays valid
JWT_EXPIRES_IN=7d

# 32-byte (256-bit) key, hex-encoded (64 hex characters), used to encrypt sensitive
# fields at rest with AES-256-GCM. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Free Sandbox credentials from https://dashboard.plaid.com (Team Settings > Keys).
# Sandbox mode only ever talks to fake banks with fake data — no real bank is
# ever contacted, no approval/waiting required to get these.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Free API key (no credit card, permanent free tier) from
# https://aistudio.google.com/apikey — powers the AI insights features.
GEMINI_API_KEY=
# Optional override; defaults to a solid free-tier model if unset. Model
# names on a fast-moving API can retire — if this ever 404s, check
# https://ai.google.dev/gemini-api/docs/models for the current lineup.
GEMINI_MODEL=gemini-3.6-flash
